# Supabase — projet Kalara (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# CinetPay (marchand)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=https://votre-api-kalara.up.railway.app/webhook/cinetpay

# Adresse publique de cette API et de l'application
APP_URL=https://votre-api-kalara.up.railway.app
KALARA_APP_URL=https://lecteur-audio-muna.netlify.app

# Clé privée de signature des licences (sur une ligne, avec \n) — npm run keys
KALARA_LICENSE_PRIVATE_KEY=

# Facultatif : envoi du code de restauration par WhatsApp
WATI_API_URL=
WATI_API_TOKEN=
